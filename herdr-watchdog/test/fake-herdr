#!/usr/bin/env python3
"""Fake herdr for the herdr-watchdog dry-run self-test (real herdr cannot be changed,
and tests must not touch panes).

  HB_FAKE_SCENARIO=<scenario.json>  # {"agents": [...], "panes": [...], "tabs": [...]}, shaped like
                                    # `herdr agent list` / `pane list` / `tab list`
  HB_FAKE_LOG=<path>                # append one line for every call that would act; dry-run tests
                                    # assert this file is empty

Implements only the three read commands herdr-watchdog uses (agent list / pane list / tab list);
everything else is logged and returns ok (simulating a real action).
"""
import json
import os
import sys

scen = json.load(open(os.environ["HB_FAKE_SCENARIO"]))
argv = sys.argv[1:]

if argv[:2] == ["agent", "list"]:
    print(json.dumps({"id": "fake:agent:list", "result": {"agents": scen.get("agents", [])}}))
    sys.exit(0)

if argv[:2] == ["pane", "list"]:
    ws = argv[argv.index("--workspace") + 1] if "--workspace" in argv else None
    panes = [p for p in scen.get("panes", []) if ws is None or p.get("workspace_id") == ws]
    print(json.dumps({"id": "fake:pane:list", "result": {"panes": panes}}))
    sys.exit(0)

if argv[:2] == ["tab", "list"]:
    print(json.dumps({"id": "fake:tab:list", "result": {"tabs": scen.get("tabs", [])}}))
    sys.exit(0)

if argv[:2] == ["session", "list"]:
    for name in scen.get("sessions", ["selftest"]):
        print("%s  running" % name)
    sys.exit(0)

if argv[:2] == ["agent", "get"]:
    print(json.dumps({"id": "fake:agent:get", "result": {"agent": {"agent_status": "idle"}}}))
    sys.exit(0)

log = os.environ.get("HB_FAKE_LOG")
if log:
    with open(log, "a") as f:
        f.write(json.dumps(argv) + "\n")
print(json.dumps({"id": "fake:ok", "result": {"type": "ok"}}))
sys.exit(0)
