#!/usr/bin/env python3
"""herdr-watchdog - watchdog v3: read/write the heartbeat-block flag, judge
pairs, and run as a daemon (README sections 1/2/5).

Flag file: $HB_DIR/<session>__<tab>.json (default ~/.herdr/watchdog/).
Only the reviewer writes it (through the hb_block tool in its profile ->
this script's `set`); the judge only reads it.

Subcommands:
  herdr-watchdog set --action block|unblock --reason "long task"  # write the flag (called by hb_block)
  herdr-watchdog show [--session S --tab T]                      # for humans: current value + recent changes
  herdr-watchdog get  [--session S --tab T]                      # print true/false (reviewer footer reads it)
  herdr-watchdog top  [--refresh 1] [--demo]                    # read-only view: vitals / pairs / who was called
  herdr-watchdog run [--dry-run] [--all-sessions] [--tab T]       # judge one pass (--dry-run prints only)
  herdr-watchdog daemon [--interval 20]                           # daemon: scan all running herdr sessions

Daemon (systemd): scans all sessions every interval seconds; pauses while
$HB_DIR/PAUSE exists; logs to $HB_DIR/watchdog.log (2 MB x 3 rotation); only
one instance at a time ($HB_DIR/.lock).
env: HERDR_SESSION / HERDR_TAB_ID / HERDR_PANE_ID pick the file; HB_DIR
overrides the directory (tests).
"""
import argparse
import fcntl
import json
import math
import os
import subprocess
import sys
import time
import unicodedata

HB_DIR = os.environ.get("HB_DIR") or os.path.expanduser("~/.herdr/watchdog")
REASON_MAX = 120         # longer reasons are truncated with "…", not rejected (rejecting would leave the pair unmuted)
                         # the loose schema gate lives in hb_block.ts (maxLength: 200, must be >= this)
HISTORY_MAX = 20         # README §2: keep the last ~20 history entries
STALE_SEC = 600          # README §1: no growth in the session file for 10 minutes = no output
INTERVAL = 20            # README §1: one pass every 20s (one pass takes ~0.07s, <0.4% duty cycle)
RUN_INTERVAL = INTERVAL  # actual daemon interval (daemon --interval changes it); written to the snapshot for top
LOG = os.path.join(HB_DIR, "watchdog.log")
PAUSE = os.path.join(HB_DIR, "PAUSE")
LOCK = os.path.join(HB_DIR, ".lock")
LOG_MAX = int(os.environ.get("HB_LOG_MAX") or 2_000_000)   # simple rotation: .1 .2 .3
LOG_KEEP = 3
SETTLE_WAIT = 5.0        # after an interrupt, wait up to this long for idle before sending
DRY = False

TEXT_HEAD = "[heartbeat] "

# README §1.4: A has two versions (reviewer stuck / worker stuck); B is neither side working.
# Messages carry no timing numbers (the number does not change the action but invites precision
# questions). The threshold is still 10 minutes, and logs/--dry-run still show the age for humans.
# Only A2 interpolates the worker pane names (possibly several).
TEXT_A1 = (TEXT_HEAD + "Your command produced no output, so I interrupted it "
           "(you may see \"Command aborted\").\n"
           '- Keep going. If a long task was interrupted by mistake, call '
           'hb_block(action=block, reason="long task") and unblock when done.')
TEXT_A2 = (TEXT_HEAD + "worker {who} has produced no output (state is still working).\n"
           '- Long task (e2e etc.)? Block on behalf of the pair: '
           'hb_block(action=block, reason="…"), then unblock when done.\n'
           '- Really stuck? Go to that pane and handle it (send-keys esc / re-dispatch).')
TEXT_B = (TEXT_HEAD + "Neither you nor the worker is working.\n"
          '- Finished this round? hb_block(action=block, reason="done")\n'
          '- Waiting for a human decision? Also block (say what you wait for), report to master\n'
          '- Still have work? Do it; read the worker with last_answer\n'
          "  I will ask again unless you block.")
LABELS = {"reviewer-stuck": "A1", "worker-stuck": "A2", "quiet": "B"}

_WARNED = set()


def log(msg):
    """One timestamped line. In dry-run it only goes to the screen; as a daemon it also goes to $HB_DIR/watchdog.log."""
    line = "%s %s" % (time.strftime("%F %T"), msg)
    print(line, flush=True)
    if DRY:
        return
    try:
        os.makedirs(HB_DIR, exist_ok=True)
        if os.path.exists(LOG) and os.path.getsize(LOG) > LOG_MAX:
            for i in range(LOG_KEEP - 1, 0, -1):
                if os.path.exists("%s.%d" % (LOG, i)):
                    os.replace("%s.%d" % (LOG, i), "%s.%d" % (LOG, i + 1))
            os.replace(LOG, LOG + ".1")
        with open(LOG, "a") as f:
            f.write(line + "\n")
    except Exception:
        pass


def warn(msg):
    """Emit each message once per process (README §1.1), so it does not flood the output."""
    if msg in _WARNED:
        return
    _WARNED.add(msg)
    log("WARN  " + msg)


def now_iso():
    return time.strftime("%FT%T")


def fmt_age(sec):
    if sec is None:
        return "?"
    if sec < 90:
        return "%.0fs" % sec
    if sec < 5400:
        return "%.0fm" % (sec / 60.0)
    return "%.1fh" % (sec / 3600.0)


# ------------------------------------------------------------------ flag file

def flag_path(session, tab):
    # README §2: <session>__<tab>.json (colons in tab are kept)
    return os.path.join(HB_DIR, "%s__%s.json" % (session, tab))


def pid_alive(pid):
    """Liveness without /proc (macOS has none): signal 0 only checks existence."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True          # exists, owned by another user
    except OSError:
        return False
    return True


def read_flag(session, tab):
    """-> dict / None (missing file, or unreadable: treat unreadable as false, never crash)"""
    try:
        with open(flag_path(session, tab)) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else None
    except FileNotFoundError:
        return None
    except Exception as e:
        warn("%s is unreadable (%r) -> treating as false" % (flag_path(session, tab), e))
        return None


def write_json(path, d):
    """Atomic write (tmp + os.replace) - used for flags and the last-pass snapshot."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


def read_json(path):
    """-> dict / None (unreadable means missing; the reader never crashes on a bad file)"""
    try:
        with open(path) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else None
    except Exception:
        return None


def write_flag(session, tab, d):
    write_json(flag_path(session, tab), d)


def where(args):
    """-> (session, tab, err)"""
    session = args.session or os.environ.get("HERDR_SESSION")
    tab = args.tab or os.environ.get("HERDR_TAB_ID")
    if not session and tab:
        # herdr does not export HERDR_SESSION for the default session. If exactly
        # one session is running, that is the one this pane belongs to.
        sessions = running_sessions(os.environ.get("HERDR_BIN_PATH") or os.environ.get("HERDR_BIN") or "herdr")
        if sessions and len(sessions) == 1:
            session = sessions[0]
    if not session or not tab:
        return None, None, "cannot locate the file: need HERDR_SESSION / HERDR_TAB_ID (or --session/--tab)"
    return session, tab, None


# ------------------------------------------------------------------ set / show

def cmd_set(args):
    session, tab, err = where(args)
    if err:
        print(err)
        return 1
    by = args.by or os.environ.get("HERDR_PANE_ID") or "unknown"
    reason = (args.reason or "").strip()
    if not reason:
        print("reason must not be empty: write one short sentence (<=%d chars)" % REASON_MAX)
        return 2
    cut = len(reason) > REASON_MAX          # truncate, never reject (README §2)
    if cut:
        reason = reason[:REASON_MAX] + "…"
    note = "\nreason was truncated (keep it short)" if cut else ""

    want = args.action == "block"
    f = read_flag(session, tab)
    cur = bool(f.get("current")) if f else False
    if want == cur:
        # README §2: no change -> write nothing
        if f:
            print("already %s (since %s, reason: %s); no change recorded%s"
                  % (str(cur).lower(), f.get("current_since", "?"), f.get("current_reason", ""), note))
        else:
            print("already false (nothing recorded); no change recorded%s" % note)
        return 0

    at = now_iso()
    hist = list(f.get("history") or []) if f else []
    hist.append({"at": at, "from": cur, "to": want, "reason": reason, "by": by})
    write_flag(session, tab, {
        "session": session,
        "tab": tab,
        "reviewer_pane": by,
        "current": want,
        "current_since": at,
        "current_reason": reason,
        "history": hist[-HISTORY_MAX:],
    })
    print("heartbeat %s (%s, since %s, reason: %s)%s"
          % ("blocked" if want else "restored", str(want).lower(), at, reason, note))
    return 0


def cmd_show(args):
    if args.session or args.tab:
        session, tab, err = where(args)
        if err:
            print(err)
            return 1
        files = [flag_path(session, tab)]
    elif os.environ.get("HERDR_TAB_ID"):
        session, tab, err = where(args)
        if err:
            print(err)
            return 1
        files = [flag_path(session, tab)]
    else:
        try:
            files = [os.path.join(HB_DIR, f) for f in sorted(os.listdir(HB_DIR)) if f.endswith(".json")]
        except FileNotFoundError:
            files = []
    if not files:
        print("(no flag files in %s)" % HB_DIR)
        return 0
    for p in files:
        show_file(p)
    return 0


def cmd_get(args):
    """Print one line, true or false - hb_block.ts reads it to refresh the footer indicator (README §2)"""
    session, tab, err = where(args)
    if err:
        print(err)
        return 1
    f = read_flag(session, tab)
    print("true" if f and f.get("current") is True else "false")
    return 0


def show_file(p):
    try:
        with open(p) as f:
            d = json.load(f)
    except FileNotFoundError:
        print("%s\n  (no such flag file; treating as false)" % p)
        return
    except Exception as e:
        print("%s\n  unreadable: %r" % (p, e))
        return
    print("%s  (session %s / tab %s, reviewer %s)"
          % (os.path.basename(p), d.get("session"), d.get("tab"), d.get("reviewer_pane")))
    print("  current: %s   since %s   reason: %s"
          % (str(bool(d.get("current"))).lower(), d.get("current_since"), d.get("current_reason")))
    hist = d.get("history") or []
    print("  history (%d total, last %d):" % (len(hist), min(len(hist), 5)))
    for h in hist[-5:][::-1]:
        print("    %s  %-5s -> %-5s  %s   by %s"
              % (h.get("at"), str(h.get("from")).lower(), str(h.get("to")).lower(),
                 h.get("reason"), h.get("by")))


# ------------------------------------------------------------------ judge (run)

def herdr(bin_path, *args):
    """-> result dict / None (any failure is None; the caller treats it as "do nothing this round")"""
    try:
        p = subprocess.run([bin_path] + list(args), capture_output=True, text=True, timeout=25)
    except Exception as e:
        warn("cannot run %s %s (%r)" % (bin_path, " ".join(args), e))
        return None
    if p.returncode != 0:
        warn("%s %s failed (exit %d: %s)"
             % (bin_path, " ".join(args), p.returncode, (p.stderr or "").strip()[:200]))
        return None
    try:
        return json.loads(p.stdout).get("result")
    except Exception as e:
        warn("%s %s output is not JSON (%r)" % (bin_path, " ".join(args), e))
        return None


def clean_label(pane_info):
    return (pane_info.get("label") or "").strip().lower()


def find_pairs(agents, panes_by_ws):
    """README §1.1: pane labels must contain both worker and reviewer.
    -> (pairs, unknown); unknown = (tab, why), warned once."""
    groups = {}
    for a in agents:
        if a.get("workspace_id") and a.get("tab_id"):
            groups.setdefault((a["workspace_id"], a["tab_id"]), []).append(a)
    pairs, unknown = [], []
    for (ws, tab), ags in sorted(groups.items(), key=lambda kv: (kv[0][0], kv[0][1])):
        if len(ags) < 2:                      # a tab with a single agent is not a pair
            continue
        labels = {a.get("pane_id"): clean_label(panes_by_ws.get(ws, {}).get(a.get("pane_id"), {}))
                  for a in ags}
        rev = [a for a in ags if "reviewer" in labels[a.get("pane_id")]]
        wrk = [a for a in ags if "worker" in labels[a.get("pane_id")]]
        if len(rev) == 1 and wrk:
            pairs.append({"ws": ws, "tab": tab, "reviewer": rev[0], "workers": wrk, "labels": labels})
        else:
            unknown.append((tab, "labels=%s"
                            % ",".join("%s:%s" % (a.get("pane_id"), labels[a.get("pane_id")] or "-")
                                       for a in ags)))
    return pairs, unknown


def pane_facts(pane, now):
    """-> (mtime_age, note). A non-empty note means this pane cannot be judged; skip it (not stuck)."""
    ses = pane.get("agent_session") or {}
    path = ses.get("value") if ses.get("kind") == "path" else None
    if not path:
        return None, "%s has no session file path (agent_session.kind=%s) -> skipping this pane" % (
            pane.get("pane_id"), ses.get("kind"))
    try:
        return now - os.stat(path).st_mtime, None
    except Exception as e:
        return None, "%s session file %s could not be stat'ed (%r) -> skipping this pane" % (pane.get("pane_id"), path, e)


def judge(pair, now):
    """Pure judgement plus the structured flags used by the view/snapshot."""
    plan = _judge(pair, now)
    f = read_flag(pair["session"], pair["tab"])
    plan.update({"flag": bool(f.get("current")) if f else False,
                 "flag_since": (f or {}).get("current_since"),
                 "flag_reason": (f or {}).get("current_reason")})
    return plan


def _judge(pair, now):
    """Pure judgement; returns a plan: action None / prompt(A|B) / interrupt, plus display lines."""
    session, tab = pair["session"], pair["tab"]
    ref = pair["reviewer"]
    panes = [ref] + pair["workers"]
    lines = []

    f = read_flag(session, tab)
    if f is None:
        lines.append("flag: no file (treating as false)")
    else:
        lines.append("flag: current=%s (since %s, reason: %s)"
                     % (str(bool(f.get("current"))).lower(),
                        f.get("current_since", "?"), f.get("current_reason", "")))
    if f and f.get("current") is True:
        lines.append("judge: flag=true -> do not disturb (return)")
        return {"action": None, "lines": lines, "panes": []}

    facts = {}
    panes_view = []
    for p in panes:
        age, note = pane_facts(p, now)
        facts[p.get("pane_id")] = (age, note)
        role = "reviewer" if p is ref else "worker"
        panes_view.append({"id": p.get("pane_id"), "role": role,
                           "status": p.get("agent_status"), "age": age, "note": note})
        if note:
            lines.append("  %s %s: %s  %s" % (p.get("pane_id"), role, p.get("agent_status", "?"), note))
            warn(note)
        else:
            lines.append("  %s %s: %s, session file changed %s ago"
                         % (p.get("pane_id"), role, p.get("agent_status", "?"), fmt_age(age)))

    def age_of(p):
        return facts[p.get("pane_id")][0]

    working = [p for p in panes if p.get("agent_status") == "working"]
    fresh = [p for p in working if age_of(p) is not None and age_of(p) < STALE_SEC]
    stuck = [p for p in working if age_of(p) is not None and age_of(p) >= STALE_SEC]

    # shortcut: as long as one pane is fresh, do not disturb the pair (README §1.3, first rule).
    # Cost: "one worker stuck while the other (or the reviewer) still produces" does not send A.
    # If this turns out to leave pairs unattended in practice, change it to "any stuck pane
    # means the pair is stuck".
    if fresh:
        lines.append("judge: a working pane produced output %s ago -> it is really working (return)"
                     % fmt_age(min(age_of(p) for p in fresh)))
        if stuck:
            lines.append("  note: another pane (%s) has been stuck for %s - returning this round per §1.3"
                         % (",".join(p["pane_id"] for p in stuck),
                            fmt_age(min(age_of(p) for p in stuck))))
        return {"action": None, "lines": lines, "panes": panes_view}

    if not working:                            # neither side working -> message B
        lines.append("judge: no pane is working -> message B")
        return {"action": "prompt", "target": ref["pane_id"], "text": TEXT_B, "why": "quiet",
                "lines": lines, "panes": panes_view}

    if any(p is ref for p in stuck):           # reviewer itself stuck -> interrupt + A1
        lines.append("judge: reviewer is working with no output for %s -> interrupt, then A1"
                     % fmt_age(age_of(ref)))
        return {"action": "interrupt", "target": ref["pane_id"], "text": TEXT_A1,
                "why": "reviewer-stuck", "lines": lines, "panes": panes_view}

    if stuck:                                  # worker stuck, reviewer idle -> A2
        ids, worst = [p["pane_id"] for p in stuck], min(age_of(p) for p in stuck)
        lines.append("judge: worker %s stuck (%s with no output), reviewer not working -> A2"
                     % (",".join(ids), fmt_age(worst)))
        return {"action": "prompt", "target": ref["pane_id"],
                "text": TEXT_A2.format(who=", ".join(ids)), "why": "worker-stuck",
                "lines": lines, "panes": panes_view}

    lines.append("judge: panes are working but output cannot be judged (missing path / stat failed) -> do nothing")
    return {"action": None, "lines": lines, "panes": panes_view}


def wait_settled(bin_path, target, timeout):
    """After esc, wait for idle/done (at most timeout seconds). If it does not settle, send anyway."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        r = herdr(bin_path, "agent", "get", target)
        st = ((r or {}).get("agent") or {}).get("agent_status")
        if st in ("idle", "done", None):
            return st
        time.sleep(0.3)
    return None


def do_action(bin_path, plan, tag):
    """Actually send / interrupt. README §1.4: interrupt the stuck reviewer first, then send."""
    if plan["action"] == "interrupt":
        if herdr(bin_path, "agent", "send-keys", plan["target"], "esc") is None:
            log("WARN  interrupt %s failed (%s)" % (plan["target"], tag))
            return
        st = wait_settled(bin_path, plan["target"], SETTLE_WAIT)
        log("ESC   interrupted %s (esc; settled: %s)" % (plan["target"], st or "timeout"))
        text, label = plan["text"], "message " + LABELS[plan["why"]]
    elif plan["action"] == "prompt":
        text, label = plan["text"], "message " + LABELS[plan["why"]]
    else:
        return
    if herdr(bin_path, "agent", "prompt", plan["target"], text) is None:
        log("WARN  send to %s failed (%s %s) -> retried next round" % (plan["target"], tag, label))
    else:
        log("SEND  %s -> %s (%s)" % (label, plan["target"], tag))


def scan_session(session, bin_path, only_tab, now):
    """One pass for one session: find pairs -> judge -> print (dry-run) / act."""
    r = herdr(bin_path, "agent", "list")
    if r is None:
        warn("%s: agent list failed -> skipping this session this round" % session)
        return None
    agents = r.get("agents") or []
    panes_by_ws = {}
    for ws in sorted({a.get("workspace_id") for a in agents if a.get("workspace_id")}):
        rp = herdr(bin_path, "pane", "list", "--workspace", ws) or {}
        panes_by_ws[ws] = {p.get("pane_id"): p for p in (rp.get("panes") or [])}

    pairs, unknown = find_pairs(agents, panes_by_ws)
    # Human-readable names: tab_id -> label (herdr tab title, e.g. in-progress / master); fall back to id.
    tab_names = {t.get("tab_id"): t.get("label")
                 for t in ((herdr(bin_path, "tab", "list") or {}).get("tabs") or [])}
    for tab, why in unknown:
        warn("%s/%s cannot identify a pair (%s) -> no heartbeat" % (session, tab, why))
    if only_tab:
        pairs = [pr for pr in pairs if pr["tab"] == only_tab]
    if not pairs:
        print("session %s: no identifiable pairs%s"
              % (session, " (--tab %s)" % only_tab if only_tab else ""))

    seen = []
    for pr in pairs:
        pr["session"] = session
        plan = judge(pr, now)
        head = "%s/%s" % (session, pr["tab"])
        seen.append({"session": session, "tab": pr["tab"], "tab_name": tab_names.get(pr["tab"]) or pr["tab"],
                     "reviewer": pr["reviewer"].get("pane_id"),
                     "workers": [p.get("pane_id") for p in pr["workers"]],
                     "panes": plan.get("panes") or [],
                     "flag": plan.get("flag"), "flag_since": plan.get("flag_since"),
                     "flag_reason": plan.get("flag_reason"),
                     "action": plan.get("action"), "target": plan.get("target"),
                     "why": plan.get("why"), "lines": plan["lines"]})
        print("\n=== %s  reviewer=%s workers=%s"
              % (head, pr["reviewer"].get("pane_id"),
                 ",".join(p.get("pane_id") for p in pr["workers"]) or "-"))
        for l in plan["lines"]:
            print("  " + l)
        if plan["action"] == "interrupt":
            print("  action: send-keys %s esc, then message %s" % (plan["target"], LABELS[plan["why"]]))
            print("  --- message %s ---" % LABELS[plan["why"]])
            print(plan["text"])
        elif plan["action"] == "prompt":
            print("  action: send message %s -> %s" % (LABELS[plan["why"]], plan["target"]))
            print("  --- message %s ---" % LABELS[plan["why"]])
            print(plan["text"])
        else:
            print("  action: none (do not disturb)")
        if not DRY:
            do_action(bin_path, plan, head)
    return {"session": session, "pairs": seen}


def running_sessions(bin_path):
    """Session names with status=running from `herdr session list`."""
    try:
        p = subprocess.run([bin_path, "session", "list"], capture_output=True, text=True, timeout=20)
    except Exception as e:
        warn("cannot run %s session list (%r)" % (bin_path, e))
        return None
    if p.returncode != 0:
        warn("%s session list failed (exit %d: %s)" % (bin_path, p.returncode, (p.stderr or "").strip()[:200]))
        return None
    out = []
    for line in p.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0] != "name" and parts[1] == "running":
            out.append(parts[0])
    return out


def one_pass(bin_path, dry, all_sessions, only_tab=None):
    global DRY
    DRY = dry
    if all_sessions:
        sessions = running_sessions(bin_path)
        if sessions is None:
            return False
        if not sessions:
            print("no running herdr sessions")
            return True
    else:
        session = os.environ.get("HERDR_SESSION")
        if not session:
            print("no HERDR_SESSION: run inside a herdr pane or use --all-sessions")
            return False
        sessions = [session]
    now = time.time()
    seen = []
    for s in sessions:
        # Switching sessions: HERDR_SOCKET_PATH wins over HERDR_SESSION, so clear it.
        os.environ.pop("HERDR_SOCKET_PATH", None)
        os.environ["HERDR_SESSION"] = s
        got = scan_session(s, bin_path, only_tab, now)
        if got is None:
            continue
        seen.extend(got["pairs"])
    if not DRY:
        write_snapshot(sessions, seen, now, time.time() - now)   # mirror for the top view; dry-run does not write
    if DRY:
        print("\n[dry-run] no messages sent, no interrupts.")
    return True


def cmd_run(args):
    return 0 if one_pass(args.herdr_bin, args.dry_run, args.all_sessions, args.tab) else 1


def cmd_daemon(args):
    global DRY, RUN_INTERVAL
    DRY = False
    RUN_INTERVAL = args.interval
    os.makedirs(HB_DIR, exist_ok=True)
    lockf = open(LOCK, "a")
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        log("WARN  an instance is already running (%s is locked) -> exiting 0" % LOCK)
        return 0
    log("start pid=%d interval=%gs scanning all running sessions; pauses while %s exists"
        % (os.getpid(), args.interval, PAUSE))
    paused = False
    while True:
        try:
            if os.path.exists(PAUSE):
                if not paused:
                    log("PAUSE present -> paused (remove it to resume)")
                    paused = True
            else:
                if paused:
                    log("PAUSE removed -> resumed")
                    paused = False
                one_pass(args.herdr_bin, dry=False, all_sessions=True)
        except Exception as e:
            log("ERR  %r" % (e,))
        time.sleep(args.interval)


# ------------------------------------------------------------------ top (read-only view, README §5)
#
# The view is a vital-signs monitor, not a table: the daemon's pass is a heartbeat.
# A scrolling braille ECG anchors one QRS per pass at ts+took, so the spike lands
# exactly when a pass lands; the pair tree hangs off the trunk below it. A call
# becomes a signal that runs down the trunk and along the branch into the pane.
# Per pair a staleness gauge shows how close a working pair is to the 10-minute
# threshold. Everything is time-based, so frames never depend on earlier frames.

def snapshot_path():
    return os.path.join(HB_DIR, "last-pass.json")


def write_snapshot(sessions, pairs, now, took=0):
    """Write what this pass saw for the top view.
    The view never judges on its own - the daemon owns the logic; the view is a mirror (and takes no lock)."""
    write_json(snapshot_path(), {
        "at": now_iso(), "ts": now, "took": took, "pid": os.getpid(), "interval": RUN_INTERVAL,
        "paused": os.path.exists(PAUSE), "sessions": sessions, "pairs": pairs,
    })


def read_snapshot():
    return read_json(snapshot_path())


TOP_DEMO = False          # `top --demo`: synthetic frames, nothing is read or written


def demo_snapshot(now):
    """Synthetic pairs for `top --demo`: one working, one called, one muted, one idle."""
    every = 10.0
    phase = now % every

    def pane(pid, role, status, age):
        return {"id": pid, "role": role, "status": status, "age": age, "note": None}

    def pair(tab, name, panes=(), flag=False, since=None, reason=None,
             action=None, target=None, why=None):
        return {"session": "demo", "tab": tab, "tab_name": name, "panes": list(panes),
                "lines": [], "flag": flag, "flag_since": since, "flag_reason": reason,
                "action": action, "target": target, "why": why}

    called = True                       # the demo pass always calls the stalled pair
    pairs = [
        pair("demo:t1", "in-progress",
             [pane("demo:p1", "reviewer", "idle", 190.0),
              pane("demo:p2", "worker", "working", 20.0 + phase * 4)]),
        pair("demo:t2", "验收 · dev→preprod",
             [pane("demo:p3", "reviewer", "working", 980.0 + phase),
              pane("demo:p4", "worker", "idle", 3000.0)],
             action="interrupt" if called else None,
             target="demo:p3" if called else None,
             why="reviewer-stuck" if called else None),
        pair("demo:t3", "design review", flag=True, since="2026-01-02T13:01:00",
             reason="waiting for a human decision"),
    ]
    return {"at": "demo", "ts": now - phase, "took": 0.03, "pid": os.getpid(),
            "interval": every, "paused": False, "sessions": ["demo"], "pairs": pairs}


TRUNK_X = 1        # the spine below the vitals
FLOW_X = 2         # branch particles run from here, the arm starts here
LEAF_X = 9         # every pane name starts at this column (keep branches aligned)
NAME_MAX = 22      # truncate long tab names so a line does not overflow
GAUGE_W = 9        # staleness gauge cells (0 .. STALE_SEC)
TRUNK_S = 0.55     # time for the signal to travel down the trunk
BRANCH_S = 0.35    # time to travel along the branch to the pane
FLASH_S = 1.50     # feedback pulse after the pane received it
RING_S = 1.20      # shockwave after the flash
FLOW_PERIOD = 3.2  # branch particle period (a working pair flows faster)
ECG_H = 3          # rows of braille ECG (12 pixels)


def dwidth(s):
    """Terminal cells a string occupies (CJK/emoji are 2, combining marks 0)."""
    n = 0
    for ch in str(s):
        if unicodedata.combining(ch):
            continue
        n += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return n


def dtrim(s, width):
    """Cut to `width` cells, adding an ellipsis when something was cut."""
    s = str(s)
    if width <= 0:
        return ""
    if dwidth(s) <= width:
        return s
    out, used = "", 0
    for ch in s:
        cw = 0 if unicodedata.combining(ch) else (2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1)
        if used + cw > width - 1:
            break
        out += ch
        used += cw
    return out + "…"


def dpad(s, width):
    """ljust for terminals: pad by display cells, not by len()."""
    s = dtrim(s, width)
    return s + " " * max(0, width - dwidth(s))


def top_put(scr, y, x, text, attr=0):
    """Draw at (y,x), clipped to width - 2 (never touch the bottom-right cell)"""
    h, w = scr.getmaxyx()
    if y < 0 or y >= h or x < 0 or w < 4 or x >= w - 2:
        return
    try:
        scr.addnstr(y, x, str(text).replace("\t", "    "), w - 2 - x, attr)
    except Exception:
        pass


def top_text(scr, y, x, text, attr=0):
    """top_put + return the next column (display-width aware)."""
    top_put(scr, y, x, text, attr)
    return x + dwidth(text)


def top_bar_parts(done, total, width):
    """Pass clock -> (filled, head+rail); the two halves get different colours."""
    width = max(3, int(width))
    total = max(float(total), 1e-6)
    ratio = max(0.0, min(1.0, float(done) / total))
    head = int(ratio * (width - 1))
    return "━" * head, "╸" + "─" * max(0, width - head - 1)


def top_hb(pr):
    """The hb column: hb:true 13:01 (hour:minute only) / hb:false"""
    on = bool(pr.get("flag"))
    since = str(pr.get("flag_since") or "")[11:16]
    return "hb:%s%s" % ("true" if on else "false", " " + since if on and since else "")


def top_face(pr):
    """The pair's mark (monochrome, so it takes the palette's colour):
    ↯ interrupted / ➤ called / ‖ muted / ◌ listening."""
    if pr.get("action") == "interrupt":
        return "↯"
    if pr.get("action"):
        return "➤"
    return "‖" if pr.get("flag") else "◌"


def top_call(pr):
    """What happened this pass: A2 → wE:pV / esc+A1 → wE:pV / — (nothing)"""
    act = {"interrupt": "esc+%s → %s", "prompt": "%s → %s"}.get(pr.get("action"))
    return act % (LABELS.get(pr.get("why"), "?"), pr.get("target")) if act else "—"


def top_working(pr):
    return any(p.get("status") == "working" for p in (pr.get("panes") or []))


def top_vitals(pr):
    """-> (kind, age). The freshest working pane sets the risk, exactly like the judge's shortcut."""
    if pr.get("flag"):
        return "blocked", None
    ages = [p.get("age") for p in (pr.get("panes") or [])
            if p.get("status") == "working" and p.get("age") is not None]
    if not ages:
        return "quiet", None
    return "work", min(ages)


def top_cols(pairs, sessions):
    """Column widths measured in display cells: name / (session:tab) / hb."""
    multi = len(sessions or []) > 1
    w_name = max([min(dwidth(pr.get("tab_name") or "?"), NAME_MAX) for pr in pairs] or [1])
    w_tab = max([dwidth("(%s%s)" % (("%s/" % pr.get("session")) if multi else "", pr.get("tab")))
                 for pr in pairs] or [1])
    w_hb = max([dwidth(top_hb(pr)) for pr in pairs] or [1])
    return w_name, w_tab, w_hb


def top_gauge(scr, y, x, pr, now, attrs):
    """Staleness gauge: how close a working pair is to the 10-minute threshold. -> (x, label, key)"""
    kind, age = top_vitals(pr)
    if kind == "blocked":
        key, label, filled = "flag_on", "muted", GAUGE_W
    elif kind == "quiet":
        key, label, filled = "gauge_bg", "idle", 0
    else:
        ratio = max(0.0, min(1.0, age / float(STALE_SEC)))
        filled = int(round(ratio * GAUGE_W))
        key = "gauge_ok" if ratio < 0.55 else ("gauge_warn" if ratio < 0.9 else "gauge_bad")
        label = "%s/10m" % fmt_age(age)
    head = filled - 1
    for i in range(GAUGE_W):
        k = key if i < filled else "gauge_bg"
        if i == head and kind == "work" and int(now * 4) % 2 == 0:
            k = key + "_hi"
        top_put(scr, y, x + i, "▰" if i < filled else "▱", attrs.get(k, attrs.get(key, 0)))
    return x + GAUGE_W, label, key


def top_leaf(scr, y, pr, cols, sessions, now, attrs, hot=False):
    """One leaf row: face + tab name + (tab) + hb value + staleness gauge + what happened."""
    h, w = scr.getmaxyx()
    w_name, w_tab, w_hb = cols
    limit = w - 2
    act, flag = pr.get("action"), bool(pr.get("flag"))
    key = "call" if act else ("flag_on" if flag else "dim")
    x = LEAF_X
    face = top_face(pr)
    face_key = "flash" if hot else key
    if flag and not act and int(now * 0.8) % 2 == 0:
        face_key = "flag_breath"
    top_put(scr, y, x, face, attrs.get(face_key, attrs.get(key, 0)))
    x += dwidth(face) + 2

    name = dpad(pr.get("tab_name") or "?", w_name)
    top_put(scr, y, x, name, attrs.get("call" if act else "name", 0))
    x += w_name + 1

    sess = "%s/" % pr.get("session") if len(sessions or []) > 1 else ""
    tab = dpad("(%s%s)" % (sess, pr.get("tab")), w_tab)
    if x + dwidth(tab) < limit:
        top_put(scr, y, x, tab, attrs.get("dim", 0))
    x += w_tab + 1

    hb = dpad(top_hb(pr), w_hb)
    if x + dwidth(hb) < limit:
        top_put(scr, y, x, hb, attrs.get("flag_on" if flag else "dim", 0))
    x += w_hb + 1

    if x + GAUGE_W + 9 < limit:
        x, label, gkey = top_gauge(scr, y, x, pr, now, attrs)
        top_put(scr, y, x + 1, dpad(label, 8), attrs.get(gkey, 0))
        x += 9

    action = top_call(pr)
    if x + dwidth(action) < limit:
        top_put(scr, y, x, action, attrs.get("call" if act else "dim", 0))
        x += dwidth(action)
    if flag and pr.get("flag_reason"):           # why the pair is muted, on the leaf
        room = limit - x - 2 - dwidth("‖ ")
        if room >= 3:
            top_text(scr, y, x + 2, "‖ " + dtrim(pr["flag_reason"], room),
                     attrs.get("flag_on", 0))
    return x


def top_pane_row(scr, y, pr, now, attrs):
    """The facts under a leaf: one segment per pane, colour = state, dot = pulse."""
    h, w = scr.getmaxyx()
    limit = w - 2
    x = LEAF_X
    panes = pr.get("panes") or []
    for i, pn in enumerate(panes):
        if x + 14 >= limit:
            top_put(scr, y, x, "…", attrs.get("dim", 0))
            return
        st, age = pn.get("status") or "?", pn.get("age")
        if pn.get("note"):
            key = "dim"
            seg = "%s %s %s" % (pn.get("id"), pn.get("role"), st)
            seg += " (%s)" % dtrim(str(pn["note"]).split("->")[0].strip(), 18)
        elif st == "working" and age is not None and age >= STALE_SEC:
            key, age_s = ("stale" if int(now * 2) % 2 else "stale_dim"), fmt_age(age)
            seg = "%s %s %s %s" % (pn.get("id"), pn.get("role"), st, age_s)
        elif st == "working":
            key, age_s = ("work_hi" if int(now * 3) % 2 else "work"), fmt_age(age)
            seg = "%s %s %s %s" % (pn.get("id"), pn.get("role"), st, age_s)
        else:
            key, age_s = "dim", fmt_age(age)
            seg = "%s %s %s %s" % (pn.get("id"), pn.get("role"), st, age_s)
        dot = "●" if st == "working" else "○"
        if x + dwidth(dot + " " + seg) >= limit:
            top_put(scr, y, x, "…", attrs.get("dim", 0))
            return
        top_put(scr, y, x, dot, attrs.get(key, 0))
        x = top_text(scr, y, x + 2, seg, attrs.get(key, 0))
        if i < len(panes) - 1:
            x = top_text(scr, y, x, "  ·  ", attrs.get("trunk", 0))



def top_chips(scr, y, w, chips, attrs, reserve=12):
    """Right-aligned status chips; low-priority ones are dropped, the title is never covered."""
    x = w - 2
    for text, key in reversed(chips):
        width = dwidth(text)
        if x - width < reserve:
            break
        top_put(scr, y, x - width, text, attrs.get(key, 0))
        x -= width
        if x - 3 >= reserve:
            top_put(scr, y, x - 3, " · ", attrs.get("dim", 0))
            x -= 3


def top_header(scr, w, snap, pairs, alive, paused, live, now, attrs):
    """Heart + shimmering name + status chips (daemon / interval / pairs / quit)."""
    h = scr.getmaxyx()[0]
    if h < 1:
        return
    phase = now % 1.0
    hit = live and (phase < 0.16 or 0.30 < phase < 0.44)
    top_put(scr, 0, 1, "♥" if hit else "♡", attrs.get("heart_hit" if hit else "heart", 0))
    word = "WATCHDOG"
    head = int(now * 7) % (len(word) + 12) - 6
    x = 3
    for i, ch in enumerate(word):
        key = "title_glow" if abs(i - head) <= 1 else "title"
        top_put(scr, 0, x, ch, attrs.get(key, 0))
        x += 1
    subtitle = "· synthetic data — not your panes" if TOP_DEMO else "· pair telemetry"
    sub_end = 0
    if w >= (66 if TOP_DEMO else 46):
        sub_end = x + 1 + dwidth(subtitle)
        top_text(scr, 0, x + 1, subtitle, attrs.get("call" if TOP_DEMO else "dim", 0))

    # low priority to the left, high priority to the right (the last one survives longest)
    sec = (snap or {}).get("sessions") or []
    chips = [("%d pair%s" % (len(pairs), "" if len(pairs) == 1 else "s"), "dim")]
    if len(sec) > 1:
        chips.append(("%d sessions" % len(sec), "dim"))
    chips.append(("%gs/pass" % float((snap or {}).get("interval") or INTERVAL), "dim"))
    if TOP_DEMO:
        chips.append(("DEMO", "call"))
    elif snap is None:
        chips.append(("no snapshot", "dim"))
    elif paused:
        chips.append(("paused", "paused"))
    elif alive:
        chips.append(("pid %s" % snap.get("pid"), "ready"))
    else:
        chips.append(("daemon gone", "dead"))
    chips.append(("? help", "title_glow"))
    chips.append(("q quit", "dim"))
    reserve = 30 if w >= 46 else max(12, min(30, (w * 2) // 5))
    if sub_end:
        reserve = max(reserve, sub_end + 1)
    top_chips(scr, 0, w, chips, attrs, reserve)


BRAILLE_BITS = ((0x01, 0x02, 0x04, 0x40), (0x08, 0x10, 0x20, 0x80))


class Braille:
    """Tiny pixel canvas: 2x4 dots per cell, so curves are smooth without half-blocks."""

    def __init__(self):
        self.cells = {}          # (row, col) -> (bits, heat)

    def dot(self, px, py, heat=0):
        col, row = px // 2, py // 4
        bits, h = self.cells.get((row, col), (0, 0))
        self.cells[(row, col)] = (bits | BRAILLE_BITS[px % 2][py % 4], max(h, heat))

    def line(self, x0, y0, x1, y1, heat=0):
        """Bresenham: connect the samples so the trace never breaks between pixels."""
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx, sy = (1 if x0 < x1 else -1), (1 if y0 < y1 else -1)
        err = dx + dy
        while True:
            self.dot(x0, y0, heat)
            if x0 == x1 and y0 == y1:
                break
            e2 = 2 * err
            if e2 >= dy:
                err += dy
                x0 += sx
            if e2 <= dx:
                err += dx
                y0 += sy

    def draw(self, scr, x0, y0, colors):
        for (row, col), (bits, heat) in self.cells.items():
            top_put(scr, y0 + row, x0 + col, chr(0x2800 + bits),
                    colors[min(heat, len(colors) - 1)])


def ecg_value(u):
    """One heartbeat in [-0.4, 1.05] over the beat (u = 0..1, fractions of one pass):
    P wave, QRS complex, T wave. Fractions keep the shape readable at any interval."""
    def g(center, sigma, amp):
        return amp * math.exp(-((u - center) / sigma) ** 2)
    return (g(0.11, 0.018, 0.22) - g(0.265, 0.008, 0.30)
            + g(0.30, 0.011, 1.05) - g(0.338, 0.012, 0.38)
            + g(0.55, 0.050, 0.46))


def top_ecg(scr, y0, rows, w, now, snap, live, attrs):
    """Scrolling braille ECG: the daemon's pass is the beat. Flatline when it is gone/paused."""
    if rows <= 0 or w < 6:
        return
    pw, ph = 2 * max(1, w - 2), 4 * rows
    base = ph - 2
    interval = max(0.4, float((snap or {}).get("interval") or INTERVAL))
    took = float((snap or {}).get("took") or 0)
    beat0 = float((snap or {}).get("ts") or now) + took
    speed = max(1.0, pw * 0.56 / interval)          # one beat spans ~56% of the screen
    amp = ph * 0.70
    cv = Braille()
    prev = None
    for px in range(pw):
        if live:
            t_at = now - (pw - 1 - px) / speed
            v = ecg_value(((t_at - beat0) % interval) / interval)
            dx = pw - 1 - px
            heat = 3 if dx < 6 else (2 if dx < 20 else (1 if dx < 48 else 0))
        else:
            # no heartbeat: a whisper of drift, nothing more
            v = 0.02 * math.sin(px * 0.7 + now * 0.6) + 0.015 * math.sin(px * 0.21 - now)
            heat = 0
        y = max(0, min(ph - 1, int(round(base - v * amp))))
        if prev is None:
            cv.dot(px, y, heat)
        else:
            cv.line(px - 1, prev, px, y, heat)
        prev = y
    cv.draw(scr, 1, y0, [attrs.get("ecg_dim", 0), attrs.get("ecg_lo", 0),
                         attrs.get("ecg_mid", 0), attrs.get("ecg_hi", 0)])

    if not live:
        if snap is None:
            label, key = "AWAITING TELEMETRY", "dim"
        elif (snap or {}).get("paused"):
            label, key = "PAUSED", "paused"
        else:
            label, key = "NO SIGNAL", "dead"
        x = max(1, (w - dwidth(label) - 2) // 2)
        top_put(scr, y0 + rows // 2, x, " " + label + " ", attrs.get(key, 0))


def top_footer(scr, y, w, now, snap, left, every, pairs, attrs, legend=True):
    """Pass clock + counts + legend on one calm line."""
    if y < 0:
        return
    dim = attrs.get("dim", 0)
    if snap is None:
        top_put(scr, y, 1, "▸ no snapshot yet — %s is empty until the daemon finishes a pass"
                % snapshot_path(), dim)
        return

    ts, took = float(snap.get("ts") or 0), float(snap.get("took") or 0)
    elapsed, total = now - ts, max(0.4, took + every)
    barw = max(8, min(30, w - 72))
    x = top_text(scr, y, 1, "DEMO   " if TOP_DEMO else "", attrs.get("call", 0))
    x = top_text(scr, y, x, "▸ ", attrs.get("bar_head", 0))
    if left is not None and left > 0.5:
        x = top_text(scr, y, x, "next %ds " % int(left + 0.5), attrs.get("bar_head", 0))
    else:
        x = top_text(scr, y, x, "passing  ", attrs.get("bar_head", 0))
    filled, rest = top_bar_parts(elapsed, total, barw)
    x = top_text(scr, y, x, filled, attrs.get("bar", 0))
    x = top_text(scr, y, x, rest, attrs.get("bar_dim", dim))
    x = top_text(scr, y, x, " %ds/%ds " % (int(elapsed), int(total)), dim)

    called = sum(1 for pr in pairs if pr.get("action"))
    blocked = sum(1 for pr in pairs if pr.get("flag"))
    listening = max(0, len(pairs) - called - blocked)
    if x + 24 < w:
        x = top_text(scr, y, x, "· ", dim)
        x = top_text(scr, y, x, "➤%d " % called, attrs.get("call", 0) if called else dim)
        x = top_text(scr, y, x, "‖%d " % blocked, attrs.get("flag_on", 0) if blocked else dim)
        x = top_text(scr, y, x, "◌%d" % listening, dim)

    hint = "▰ quiet → 10m   ➤ called   ‖ muted   ◌ listening"
    if legend and x + dwidth(hint) + 4 < w:
        top_put(scr, y, w - 2 - dwidth(hint), hint, dim)


def top_help(scr, attrs):
    """The `?` page: what the marks and the gauge mean (any key closes)."""
    h, w = scr.getmaxyx()
    scr.erase()
    dim = attrs.get("dim", 0)
    lines = [
        ("pair", "one worker + one reviewer tab the watchdog watches"),
        ("┣ ┗", "one branch per pair; the line under it lists its panes"),
        ("", ""),
        ("♥ ♡", "one heartbeat = one daemon pass (the scrolling ECG)"),
        ("", "flatline / NO SIGNAL = daemon gone or paused"),
        ("➤", "a call was sent this pass; → shows the target pane"),
        ("↯", "the reviewer was interrupted (esc), then messaged"),
        ("‖", "muted by hb_block(block); time/reason on the row"),
        ("◌", "listening: the pair is alive, nothing was sent"),
        ("—", "nothing was sent this pass"),
        ("▰▱", "quiet time of the freshest working pane / 10m"),
        ("● ○", "pane working / idle; red ● = working, no output 10m"),
        ("", ""),
        ("?", "close this help"),
        ("q esc", "quit"),
    ]
    label_w = 7
    body = max([dwidth(t) for _l, t in lines] or [1])
    inner = max(24, min(w - 4, body + label_w + 5))
    x0 = max(1, (w - inner - 2) // 2)
    y0 = max(0, (h - len(lines) - 2) // 2)
    top_put(scr, y0, x0, "╭" + "─" * inner + "╮", dim)
    for i in range(len(lines)):
        top_put(scr, y0 + 1 + i, x0, "│", dim)
        top_put(scr, y0 + 1 + i, x0 + inner + 1, "│", dim)
    top_put(scr, y0 + len(lines) + 1, x0, "╰" + "─" * inner + "╯", dim)
    title = " herdr-watchdog top · legend "
    top_put(scr, y0, x0 + max(1, (inner - dwidth(title)) // 2), title,
            attrs.get("title_glow", 0))
    for i, (label, text) in enumerate(lines):
        y = y0 + 1 + i
        if not label and not text:
            continue
        top_put(scr, y, x0 + 2, dpad(label, label_w), attrs.get("call", 0))
        if text:
            room = max(1, inner - label_w - 3)
            top_put(scr, y, x0 + 2 + label_w + 1, dtrim(text, room), attrs.get("name", 0))


def top_draw(scr, attrs=None):
    """One frame. Reads the snapshot only; never acts. -> (animating, seconds until next pass)"""
    attrs = attrs or {}
    h, w = scr.getmaxyx()
    scr.erase()
    now = time.time()
    snap = demo_snapshot(now) if TOP_DEMO else read_snapshot()
    dim = attrs.get("dim", 0)

    # Keep the daemon's order: a call must not make rows jump under the reader's eyes.
    pairs = list((snap or {}).get("pairs") or [])
    sessions = (snap or {}).get("sessions") or []
    pid = (snap or {}).get("pid")
    every = float((snap or {}).get("interval") or INTERVAL)
    paused = bool((snap or {}).get("paused"))
    alive = bool(pid) and pid_alive(pid)
    left, age = None, 1e9
    if snap:
        ts, took = float(snap.get("ts") or 0), float(snap.get("took") or 0)
        left = (took + every) - (now - ts)
        age = now - (ts + took)
    live = bool(snap) and alive and not paused and age < every * 2.5

    top_header(scr, w, snap, pairs, alive, paused, live, now, attrs)
    rows = ECG_H if h >= 9 else (2 if h >= 6 else 0)
    if h >= 30:
        rows = 5
    elif h >= 24:
        rows = 4
    if not (rows and 1 + rows <= h - 2):
        rows = 0
    if rows:
        top_ecg(scr, 1, rows, w, now, snap, live, attrs)
    cols = top_cols(pairs, sessions)
    head_h = 1 if pairs and h >= 14 else 0
    if head_h:
        w_name, w_tab, w_hb = cols
        x_name = LEAF_X + 3
        x_tab = x_name + w_name + 1
        x_hb = x_tab + w_tab + 1
        x_gauge = x_hb + w_hb + 1
        x_act = x_gauge + GAUGE_W + 9
        top_put(scr, 1 + rows, x_name, "PAIR", dim)
        top_put(scr, 1 + rows, x_tab, "TAB", dim)
        top_put(scr, 1 + rows, x_hb, "HB_BLOCK", dim)
        top_put(scr, 1 + rows, x_gauge, "QUIET/10m", dim)
        top_put(scr, 1 + rows, x_act, "LAST CALL", dim)
    y = 1 + rows + head_h
    foot = h - 1

    # Layout first (leaf + pane facts per pair, a breath between pairs when it fits),
    # then draw the trunk, then the leaves. Stable: no row ever depends on a timer.
    row_of, end_of, y0 = {}, {}, y
    need_all = sum((2 if pr.get("panes") else 1) for pr in pairs)
    gap = 1 if pairs and need_all + len(pairs) - 1 <= foot - y0 else 0
    y = y0
    for i, pr in enumerate(pairs):
        need = 2 if pr.get("panes") else 1
        if y + need >= foot:
            break
        row_of[i] = y
        end_of[i] = y + need - 1
        y += need
        nxt = pairs[i + 1] if i + 1 < len(pairs) else None
        if gap and nxt is not None and y + 1 + (2 if nxt.get("panes") else 1) < foot:
            y += 1
    last = max(end_of.values()) if end_of else y0 - 1
    more = len(pairs) - len(row_of)
    more_y = y
    if row_of:
        for r in range(y0, last + 1):
            top_put(scr, r, TRUNK_X, "┃", attrs.get("trunk", dim))
        # falling sparks in the conduit next to the trunk
        span = max(1, last - y0 + 1)
        drift = now * 3.5 if live else 0
        for k in range(0, span, 4):
            top_put(scr, y0 + int((k + drift) % span), FLOW_X, "⠂",
                    attrs.get("flow" if live else "trunk", dim))
    else:
        top_put(scr, y0, TRUNK_X, "┗━", attrs.get("trunk", dim))

    called = [i for i, pr in enumerate(pairs) if pr.get("action") and i in row_of]
    animating = bool(called) and 0 <= age <= TRUNK_S + BRANCH_S + FLASH_S
    n = max(1, len(pairs))

    for i, pr in enumerate(pairs):
        if i not in row_of:
            continue
        y = row_of[i]
        top_pair_last = i == len(pairs) - 1 and not more
        top_put(scr, y, TRUNK_X, "┗" if top_pair_last else "┣", attrs.get("trunk", dim))
        arm = max(1, LEAF_X - FLOW_X - 1)
        top_put(scr, y, FLOW_X, "━" * arm, attrs.get("trunk", dim))

        # a particle flowing out to the pane: fast for a working pair, slow otherwise
        working = top_working(pr)
        period = FLOW_PERIOD * (1.0 if working else 2.2)
        slot = max(1, arm - 2)
        pos = int(((((now if live else 0) + i * 0.9) % period) / period) * slot)
        top_put(scr, y, FLOW_X + 1 + min(slot - 1, pos), "●",
                attrs.get(("work" if working else "flow") if live else "trunk", dim))

        hot = False
        if i in called and 0 <= age <= TRUNK_S + BRANCH_S + FLASH_S:
            t0 = TRUNK_S * (i + 1) / n
            if age >= t0:
                # light the trunk down to this leaf
                for r in range(y0, y + 1):
                    ch = ("┗" if top_pair_last else "┣") if r == y else "┃"
                    top_put(scr, r, TRUNK_X, ch, attrs.get("signal", 0))
                bp = min(1.0, (age - t0) / BRANCH_S)
                nx = FLOW_X + int(bp * (arm - 1))
                top_put(scr, y, FLOW_X, "━" * max(0, nx - FLOW_X), attrs.get("signal", 0))
                if bp < 1.0:
                    top_put(scr, y, nx, "●", attrs.get("signal", 0))       # comet on the branch
                else:
                    hot = True                                            # arrived: flash the leaf
                    since = age - t0 - BRANCH_S
                    r = int(since * 20)                                    # shockwave rings
                    if since < RING_S:
                        for k in (r + 1, r + 6):
                            rx = LEAF_X - 2 - k
                            if FLOW_X <= rx < LEAF_X - 2:
                                top_put(scr, y, rx, "✧", attrs.get("ring", 0))
                    top_put(scr, y, LEAF_X - 2,
                            "✦" if int(since / 0.16) % 2 == 0 else " ", attrs.get("flash", 0))

        top_leaf(scr, y, pr, cols, sessions, now, attrs, hot=hot)
        if pr.get("panes"):
            top_put(scr, y + 1, TRUNK_X, "┃", attrs.get("trunk", dim))
            top_pane_row(scr, y + 1, pr, now, attrs)

    if more:
        top_put(scr, min(more_y, foot - 1), TRUNK_X, "┗━ …(%d more)" % more, dim)

    legend = ("♥ each pass is one beat   ·   ▰ quiet time → 10m   ·   "
              "➤ called   ·   ‖ muted   ·   ◌ listening")
    spare = foot - 1 - last
    show_legend = not more and spare >= 2 and dwidth(legend) + 4 <= w
    if show_legend:
        top_put(scr, foot - 1, max(1, (w - dwidth(legend)) // 2), legend,
                attrs.get("trunk", dim))
    elif snap is not None and not pairs:
        msg = "no worker/reviewer pairs in this pass"
        top_put(scr, y0 + max(1, (foot - y0) // 2), max(1, (w - dwidth(msg)) // 2), msg, dim)
    top_footer(scr, foot, w, now, snap, left, every, pairs, attrs, legend=not show_legend)

    return animating, left


def top_attr_table():
    """-> attrs dict; a 256-colour palette when the terminal has one, 8 colours otherwise."""
    import curses
    try:
        curses.start_color()
        curses.use_default_colors()
    except Exception:
        pass
    rich = curses.COLORS >= 256

    # Catppuccin Mocha, mapped to the nearest xterm-256 slot. Low saturation,
    # no A_DIM on 256-colour terminals: the muted slots already sit near the
    # background (#1e1e2e), so dimming them again would make the lines disappear.
    specs = [
        ("title", 189, curses.COLOR_WHITE, curses.A_BOLD),        # text
        ("title_glow", 147, curses.COLOR_CYAN, curses.A_BOLD),    # lavender
        ("name", 189, curses.COLOR_WHITE, 0),                     # text
        ("dim", 103, curses.COLOR_WHITE, curses.A_DIM),           # overlay1
        ("heart", 181, curses.COLOR_RED, 0),                      # maroon
        ("heart_hit", 211, curses.COLOR_RED, curses.A_BOLD),      # red
        ("ecg_dim", 138, curses.COLOR_RED, curses.A_DIM),         # old trace
        ("ecg_lo", 181, curses.COLOR_RED, curses.A_DIM),          # maroon
        ("ecg_mid", 211, curses.COLOR_RED, 0),                    # red
        ("ecg_hi", 224, curses.COLOR_RED, curses.A_BOLD),         # rosewater
        ("trunk", 103, curses.COLOR_WHITE, curses.A_DIM),         # overlay1
        ("flow", 147, curses.COLOR_MAGENTA, 0),                   # lavender
        ("call", 216, curses.COLOR_YELLOW, curses.A_BOLD),        # peach
        ("signal", 224, curses.COLOR_YELLOW, curses.A_BOLD),      # rosewater
        ("flash", 189, curses.COLOR_WHITE, curses.A_REVERSE | curses.A_BOLD),
        ("ring", 147, curses.COLOR_MAGENTA, curses.A_BOLD),       # lavender
        ("flag_on", 223, curses.COLOR_YELLOW, 0),                 # yellow
        ("flag_breath", 180, curses.COLOR_YELLOW, curses.A_DIM),  # gold
        ("work", 151, curses.COLOR_GREEN, 0),                     # green
        ("work_hi", 157, curses.COLOR_GREEN, curses.A_BOLD),
        ("stale", 211, curses.COLOR_RED, curses.A_BOLD),          # red
        ("stale_dim", 181, curses.COLOR_RED, 0),                  # maroon
        ("gauge_ok", 151, curses.COLOR_GREEN, 0),
        ("gauge_ok_hi", 157, curses.COLOR_GREEN, curses.A_BOLD),
        ("gauge_warn", 223, curses.COLOR_YELLOW, 0),
        ("gauge_warn_hi", 229, curses.COLOR_YELLOW, curses.A_BOLD),
        ("gauge_bad", 211, curses.COLOR_RED, 0),
        ("gauge_bad_hi", 217, curses.COLOR_RED, curses.A_BOLD),
        ("gauge_bg", 243, curses.COLOR_WHITE, curses.A_DIM),      # overlay0
        ("bar", 111, curses.COLOR_CYAN, 0),                       # blue
        ("bar_head", 224, curses.COLOR_YELLOW, curses.A_BOLD),    # rosewater
        ("bar_dim", 243, curses.COLOR_WHITE, curses.A_DIM),
        ("ready", 151, curses.COLOR_GREEN, curses.A_BOLD),        # green
        ("paused", 223, curses.COLOR_YELLOW, curses.A_BOLD),      # yellow
        ("dead", 211, curses.COLOR_RED, curses.A_BOLD),           # red
    ]
    attrs = {}
    for n, (key, fg, fallback, extra) in enumerate(specs, start=1):
        try:
            curses.init_pair(n, fg if rich else fallback, -1)
            if rich:
                extra &= ~curses.A_DIM
            attrs[key] = curses.color_pair(n) | extra
        except Exception:
            attrs[key] = extra
    return attrs


def cmd_top(args):
    """Read-only view: attach to see what the daemon is doing. No actions, no messages, no lock."""
    global TOP_DEMO
    TOP_DEMO = bool(getattr(args, "demo", False))
    try:
        import curses
    except ImportError:
        print("curses is not available on this machine; cannot show the full-screen view")
        return 1

    def loop(scr):
        try:
            curses.curs_set(0)
        except Exception:
            pass
        try:
            scr.keypad(True)
        except Exception:
            pass
        attrs = {}
        try:
            attrs = top_attr_table()
        except Exception:
            pass
        idle = max(40, int(float(getattr(args, "refresh", 1.0) or 1.0) * 80))
        show_help = False
        while True:
            if show_help:
                top_help(scr, attrs)
            else:
                animating, left = top_draw(scr, attrs)
            scr.refresh()
            # ~12 fps idle (the ECG scrolls), 25 fps while a call is in flight
            scr.timeout(-1 if show_help else (40 if animating else idle))
            ch = scr.getch()
            if show_help:
                show_help = False
                if ch in (ord("q"), ord("Q"), 27):
                    return
                continue
            if ch in (ord("q"), ord("Q"), 27):
                return
            if ch == ord("?"):
                show_help = True

    curses.wrapper(loop)
    return 0


# ------------------------------------------------------------------ main

def main():
    argv = sys.argv[1:]
    # Allow `herdr-watchdog --dry-run` without the `run` subcommand.
    if not argv or argv[0].startswith("-"):
        argv = ["run"] + argv

    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p_set = sub.add_parser("set", help="write the flag (called by the reviewer's hb_block tool)")
    p_set.add_argument("--action", choices=["block", "unblock"], required=True)
    p_set.add_argument("--reason", required=True, help="one short sentence (<=%d chars)" % REASON_MAX)
    p_set.add_argument("--session", default=None)
    p_set.add_argument("--tab", default=None)
    p_set.add_argument("--by", default=None, help="which pane wrote it (default HERDR_PANE_ID)")
    p_set.set_defaults(fn=cmd_set)

    p_show = sub.add_parser("show", help="for humans: current value + recent changes")
    p_show.add_argument("--session", default=None)
    p_show.add_argument("--tab", default=None)
    p_show.set_defaults(fn=cmd_show)

    p_get = sub.add_parser("get", help="print true/false (for the footer indicator)")
    p_get.add_argument("--session", default=None)
    p_get.add_argument("--tab", default=None)
    p_get.set_defaults(fn=cmd_get)

    p_top = sub.add_parser("top", help="read-only view: heartbeat / who was called (q quits)")
    p_top.add_argument("--demo", action="store_true",
                       help="preview the animation with synthetic pairs (reads and writes nothing)")
    p_top.add_argument("--refresh", type=float, default=1.0,
                       help="idle redraw multiplier (default 1 = ~12 fps; 25 fps while a call is in flight)")
    p_top.set_defaults(fn=cmd_top)

    p_run = sub.add_parser("run", help="judge one pass (--dry-run prints only)")
    p_run.add_argument("--dry-run", action="store_true")
    p_run.add_argument("--all-sessions", action="store_true", help="scan all running herdr sessions")
    p_run.add_argument("--tab", default=None, help="judge only this tab (debug; default all)")
    p_run.add_argument("--herdr-bin", default="herdr", help="herdr executable (use a fake in tests)")
    p_run.set_defaults(fn=cmd_run)

    p_daemon = sub.add_parser("daemon", help="run as a daemon (systemd calls this)")
    p_daemon.add_argument("--interval", type=float, default=INTERVAL)
    p_daemon.add_argument("--herdr-bin", default="herdr")
    p_daemon.set_defaults(fn=cmd_daemon)

    args = ap.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
