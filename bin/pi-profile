#!/usr/bin/env bash
# Run pi with a profile from ~/.pi/agent/profiles/<name>.conf.
# The conf sets a bash array: PROFILE=( -e ... --tools ... ).
#
# Inside a herdr pane the role comes from the pane label, so the profile and
# the label (which the watchdog and last_answer use) cannot disagree:
#   pi-profile            -> worker or reviewer, from the label
#   pi-profile worker     -> refused unless the pane is labeled worker
set -euo pipefail

label_profile() {   # exact label -> profile from labels.conf, if present
  local label=$1 f="$HOME/.pi/agent/profiles/labels.conf" k v
  [ -r "$f" ] || return 0
  while IFS='=' read -r k v; do
    k=${k//[[:space:]]/}
    v=${v//[[:space:]]/}
    [ -z "$k" ] || [ "${k:0:1}" = "#" ] && continue
    if [ "$k" = "$label" ]; then printf '%s\n' "$v"; return 0; fi
  done < "$f"
}

role_from_label() {
  [ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ] || return 0
  local json label mapped
  json=$(herdr pane get "$HERDR_PANE_ID" 2>/dev/null) || return 0
  label=$(printf '%s' "$json" | sed -n 's/.*"label" *: *"\([^"]*\)".*/\1/p' | head -1)
  mapped=$(label_profile "$label")
  [ -n "$mapped" ] && { printf '%s\n' "$mapped"; return 0; }
  case "$label" in
    *worker*reviewer* | *reviewer*worker*) return 0 ;;   # ambiguous: no guess
    *reviewer*) printf 'reviewer\n' ;;
    *worker*)   printf 'worker\n' ;;
  esac
}

pane_role=$(role_from_label)
name=""
if [ -n "${1:-}" ] && [ "${1#-}" = "$1" ]; then   # a bare word is the role; -flags go to pi
  name=$1
  shift
fi
[ -n "$name" ] || name=$pane_role

if [ -z "$name" ]; then
  echo "usage: pi-profile [worker|reviewer] [pi args...]" >&2
  echo "inside a labeled herdr pane, run it with no argument: the role comes from the label." >&2
  exit 2
fi

if [ -n "$pane_role" ] && [ "$name" != "$pane_role" ]; then
  echo "pi-profile: this pane is labeled '$pane_role'; refusing to start the '$name' profile." >&2
  echo "start it with: pi-profile    (no argument), or rename the pane first." >&2
  exit 2
fi

# The resume-command reporter (resume-profile/resume_argv.ts) takes the profile
# name from here, so a restored pane comes back as the same role.
export HERDR_PAIR_PROFILE="$name"

f="$HOME/.pi/agent/profiles/$name.conf"
[ -r "$f" ] || {
  echo "pi-profile: no such profile: $f" >&2
  echo "available: $(ls "$HOME/.pi/agent/profiles" 2>/dev/null | sed -n 's/\.conf$//p' | tr '\n' ' ')" >&2
  exit 1
}
command -v pi >/dev/null || { echo "pi-profile: pi is not on PATH" >&2; exit 1; }

PROFILE=()
# shellcheck source=/dev/null
. "$f"
exec pi -ne -ns -np --no-mcp "${PROFILE[@]}" "$@"
